{
  "info": {
    "_postman_id": "bonus-player-integration-v1",
    "name": "Bonus — Player Integration (Click)",
    "description": "All bonus endpoints that the Click (game client) communicates with.\n\nBase URL: https://qa-app.fozilpartners.com\nClient: site1-backend-v0\n\nAuth: every request requires X-Client-Id, X-Timestamp (Unix epoch), and X-Signature (HMAC-SHA256).\nThe pre-request script on this collection computes X-Timestamp and X-Signature automatically — just keep clientId and clientSecret variables up to date.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://qa-app.fozilpartners.com",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "site1-backend-v0",
      "type": "string"
    },
    {
      "key": "clientSecret",
      "value": "abc@123456",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "USER_001",
      "type": "string"
    },
    {
      "key": "consumeTxnId",
      "value": "TXN20250519001",
      "type": "string"
    },
    {
      "key": "txnId",
      "value": "15",
      "type": "string"
    },
    {
      "key": "x_timestamp",
      "value": "",
      "type": "string"
    },
    {
      "key": "x_signature",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Canonical string: clientId\\ntimestamp\\nqueryString\\n + body",
          "// Signature: HMAC-SHA256(clientSecret, canonical).hexdigest()",
          "",
          "var clientId     = pm.collectionVariables.get('clientId');",
          "var clientSecret = pm.collectionVariables.get('clientSecret');",
          "var timestamp    = Math.floor(Date.now() / 1000).toString();",
          "",
          "// Build query string — substitute {{vars}} so it matches what the server receives",
          "var enabledParams = pm.request.url.query.filter(function(p) { return !p.disabled; });",
          "var queryString = enabledParams.map(function(p) {",
          "    return pm.variables.replaceIn(p.key) + '=' + pm.variables.replaceIn(p.value);",
          "}).join('&');",
          "",
          "// Body — substitute {{vars}} to match the actual bytes the server sees",
          "var rawBody = (pm.request.body && pm.request.body.raw) ? pm.request.body.raw : '';",
          "var bodyStr = pm.variables.replaceIn(rawBody);",
          "",
          "// Canonical string matches Python: f\"{client_id}\\n{timestamp}\\n{query_string}\\n\".encode() + body",
          "var canonical = clientId + '\\n' + timestamp + '\\n' + queryString + '\\n' + bodyStr;",
          "",
          "// HMAC-SHA256",
          "var signature = CryptoJS.HmacSHA256(canonical, clientSecret).toString(CryptoJS.enc.Hex);",
          "",
          "pm.collectionVariables.set('x_timestamp', timestamp);",
          "pm.collectionVariables.set('x_signature', signature);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Event Tracking",
      "description": "Events sent by Click to /api/v1/events/track.\n\nAuth: X-Client-Id + X-Client-Secret headers (no HMAC — different from bonus S2S auth).\nevent_id and timestamp are generated dynamically via Postman built-ins.",
      "item": [
        {
          "name": "BET_PLACED",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",    "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"{{$guid}}\",\n      \"event_name\": \"BET_PLACED\",\n      \"schema_version\": 1,\n      \"user_id\": \"{{userId}}\",\n      \"session_id\": \"sess_abc123\",\n      \"timestamp\": \"{{$isoTimestamp}}\",\n      \"sdk\": { \"name\": \"site1-backend-v0\", \"version\": \"1.0.0\" },\n      \"device\": { \"platform\": \"web\" },\n      \"properties\": {\n        \"transaction_amount\": \"1000.0000\",\n        \"bonus_amount\": \"100.0000\",\n        \"chip_type\": \"CASH\",\n        \"wager_tnx_id\": \"WAGER_REF_001\",\n        \"session_key\": \"sess_rummy_abc123\",\n        \"platform_client_id\": \"platform_client_001\",\n        \"product\": \"RUMMY\",\n        \"game_type\": \"TOURNEY\",\n        \"game_variant\": \"holdem\",\n        \"game_name\": \"Friday Holdem\",\n        \"game_action\": \"REGISTER_TOURNY\",\n        \"primary_transaction_id\": 1,\n        \"secondary_transaction_id\": 2,\n        \"tertiary_transaction_id\": 3,\n        \"base_request_id\": 3\n      }\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/track",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "track"]
            },
            "description": "Wager event from Click. Sent when a bet is accepted.\n\nbalance_type: real | bonus | freebet\nproduct_id: generic product/market reference (casino clients may use game_id instead)\ncategory: slots | sports | casino | crash | fantasy | etc.\n\nCasino legacy fields (game_id, game_category, game_provider) are also accepted for backward compatibility."
          },
          "response": [
            {
              "name": "202 Accepted",
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/events/track" }
              },
              "status": "Accepted",
              "code": 202,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"accepted\": 1,\n  \"rejected\": 0,\n  \"errors\": []\n}"
            },
            {
              "name": "400 Bad Request — missing required field",
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/events/track" }
