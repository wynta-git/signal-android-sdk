    {
      "name": "Consume & Revert",
      "item": [
        {
          "name": "Consume Bonus (Wager Event)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Client-Id",  "value": "{{clientId}}" },
              { "key": "X-Timestamp",  "value": "{{x_timestamp}}" },
              { "key": "X-Signature",  "value": "{{x_signature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"consume_txn_id\": \"{{consumeTxnId}}\",\n  \"transaction_amount\": \"1000.0000\",\n  \"bonus_amount\": \"100.0000\",\n  \"chip_type\": \"CASH\",\n  \"wager_tnx_id\": \"WAGER_REF_001\",\n  \"session_key\": \"sess_rummy_abc123\",\n  \"platform_client_id\": \"platform_client_001\",\n  \"product\": \"RUMMY\",\n  \"game_type\": \"TOURNEY\",\n  \"game_variant\": \"holdem\",\n  \"game_name\": \"Friday Holdem\",\n  \"game_action\": \"REGISTER_TOURNY\",\n  \"primary_transaction_id\": 1,\n  \"secondary_transaction_id\": 2,\n  \"tertiary_transaction_id\": 3,\n  \"base_request_id\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bonus/user-bonuses/consume",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bonus", "user-bonuses", "consume"]
            },
            "description": "Record that a released bonus chunk has been consumed against a wager.\n\nconsumo_txn_id is an idempotency key — reuse it on retries. Returns 409 on duplicate or if no released chunk exists."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/bonus/user-bonuses/consume" }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"txn_id\": 88,\n  \"consume_txn_id\": \"TXN20250519001\",\n  \"bonus_amount\": \"100.00\",\n  \"consumed_amount\": \"100.00\",\n  \"chip_type\": \"cash\"\n}"
            },
            {
              "name": "409 Conflict",
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/bonus/user-bonuses/consume" }
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"detail\": \"consume_txn_id already exists or no released chunk available\"\n}"
            }
          ]
        },
        {
          "name": "Revert Consumption",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Client-Id",  "value": "{{clientId}}" },
              { "key": "X-Timestamp",  "value": "{{x_timestamp}}" },
              { "key": "X-Signature",  "value": "{{x_signature}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bonus/user-bonuses/consume/{{consumeTxnId}}/revert",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bonus", "user-bonuses", "consume", "{{consumeTxnId}}", "revert"]
            },
            "description": "Cancel a previously recorded consumption (e.g. voided wager). Use the same consume_txn_id from the Consume call. Returns 409 if already reverted."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/bonus/user-bonuses/consume/TXN20250519001/revert" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"txn_id\": 88,\n  \"consume_txn_id\": \"TXN20250519001\",\n  \"amount\": \"100.00\",\n  \"chip_type\": \"cash\"\n}"
            },
            {
              "name": "409 Conflict — already reverted",
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/bonus/user-bonuses/consume/TXN20250519001/revert" }
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"detail\": \"Consumption already reverted\"\n}"
            }
          ]
        }
      ]
    },
