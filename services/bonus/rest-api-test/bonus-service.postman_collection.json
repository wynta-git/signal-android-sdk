{
  "info": {
    "name": "Bonus Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "bonus_head_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "bonus_subhead_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bonus Heads",
      "item": [
        {
          "name": "Get detail — existing head",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bonus-heads/{{bonus_head_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has id', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.test('has owners array', () => pm.expect(body.owners).to.be.an('array'));",
                  "pm.test('has subheads array', () => pm.expect(body.subheads).to.be.an('array'));",
                  "pm.test('has budget array', () => pm.expect(body.budget).to.be.an('array'));",
                  "if (body.owners.length > 0) {",
                  "    const o = body.owners[0];",
                  "    pm.test('owner has username+role+active', () => {",
                  "        pm.expect(o).to.have.all.keys('username', 'role', 'active');",
                  "    });",
                  "}",
                  "if (body.subheads.length > 0) {",
                  "    const s = body.subheads[0];",
                  "    pm.test('subhead has id+name+active+owner', () => {",
                  "        pm.expect(s).to.include.all.keys('id', 'name', 'active', 'owner');",
                  "    });",
                  "}",
                  "if (body.budget.length > 0) {",
                  "    const b = body.budget[0];",
                  "    pm.test('budget entry has period_type+used', () => {",
                  "        pm.expect(b).to.include.all.keys('period_type', 'used');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get detail — hardcoded id 1 (seed data)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bonus-heads/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('name is Welcome', () => pm.expect(body.name).to.eql('Welcome'));",
                  "pm.test('budget periods', () => {",
                  "    const periods = body.budget.map(b => b.period_type);",
                  "    pm.expect(periods).to.include.members(['DAILY', 'WEEKLY', 'MONTHLY']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get detail — not found → 404",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bonus-heads/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('has detail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update head — rename and deactivate",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/bonus-heads/{{bonus_head_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Welcome Bonus v2\",\n  \"active\": false,\n  \"updated_by\": \"ops.team\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('name updated', () => pm.expect(body.name).to.eql('Welcome Bonus v2'));",
                  "pm.test('active is false', () => pm.expect(body.active).to.be.false);",
                  "pm.test('updated_by set', () => pm.expect(body.updated_by).to.eql('ops.team'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update head — clear description",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/bonus-heads/{{bonus_head_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
