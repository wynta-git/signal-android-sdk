<?xml version="1.0" encoding="utf-8"?>
<!-- "branded" template — NOT used with DecoratedCustomViewStyle (unlike standard/hero_banner):
     the composer mockup shows the accent color covering the whole card, and DecoratedCustomViewStyle's
     own header decoration can't be colored. This layout does NOT build its own icon/app-name/
     timestamp row either — Android 12+ already draws a mandatory app-identity strip (icon, app
     name, timestamp, expand chevron) above every notification's content area, custom or not,
     with no API to suppress it. Adding our own copy of that here just duplicated it. So this
     layout owns only the content area (title/body/large icon); the outer identity strip stays
     system-drawn and uncolored — an accepted platform ceiling. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wynta_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wynta_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wynta_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:maxLines="4"
                android:ellipsize="end" />

        </LinearLayout>

        <ImageView
            android:id="@+id/wynta_large_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
