<?xml version="1.0" encoding="utf-8"?>
<!-- Dark gradient behind the overlaid title/body text on the hero_banner image — transparent
     at top, fading to solid-ish black at the bottom, so white text stays legible regardless
     of what's underneath in the photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#00000000"
        android:centerColor="#66000000"
        android:endColor="#CC000000" />
</shape>
